{
  "name": "testforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "TestForge AI - enterprise SDET and intelligent test automation platform",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "csv-parse": "7.0.3",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "db:start": "bash scripts/db-local.sh start",
    "db:stop": "bash scripts/db-local.sh stop",
    "db:status": "bash scripts/db-local.sh status",
    "db:destroy": "bash scripts/db-local.sh destroy",
    "db:migrate": "cd apps/api && .venv/bin/alembic upgrade head",
    "db:seed": "cd apps/api && .venv/bin/python -m app.seed",
    "db:reset": "cd apps/api && .venv/bin/alembic upgrade head && .venv/bin/python -m app.seed --reset",
    "test:backend": "cd apps/api && .venv/bin/python -m pytest",
    "test:backend:coverage": "cd apps/api && .venv/bin/python -m pytest --cov=app --cov-report=term-missing",
    "lint:backend": "cd apps/api && .venv/bin/ruff check . && .venv/bin/ruff format --check .",
    "typecheck": "npm run typecheck -w apps/web && tsc --noEmit -p tsconfig.json",
    "build": "npm run build -w apps/web",
    "openapi:export": "apps/api/.venv/bin/python scripts/export_openapi.py && npm run generate:api-types -w apps/web",
    "lint": "eslint . --max-warnings 0",
    "e2e:install": "playwright install chromium firefox webkit",
    "test:e2e": "playwright test --project=framework --project=chromium --project=firefox --project=webkit",
    "test:e2e:chromium": "playwright test --project=framework --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:critical": "playwright test --grep @critical --project=chromium --project=webkit",
    "test:e2e:regression": "playwright test --project=framework --project=chromium --project=firefox --project=webkit --grep @regression",
    "test:api": "playwright test --project=api",
    "test:contract": "playwright test --project=contract",
    "test:db": "playwright test --project=database",
    "test:security": "playwright test --project=security",
    "test:reliability": "playwright test --project=reliability",
    "test:service": "playwright test --project=api --project=contract --project=database --project=security --project=reliability",
    "test:a11y": "playwright test --project=accessibility",
    "test:a11y:keyboard": "playwright test --project=keyboard-webkit",
    "perf:install": "bash scripts/install-k6.sh",
    "perf:migrate": "cd apps/api && DATABASE_URL=postgresql+psycopg://testforge:testforge_local@127.0.0.1:55432/testforge_perf APP_ENV=test .venv/bin/alembic upgrade head",
    "perf": "npm run -s db:start && npm run -s perf:migrate && node scripts/perf.mjs",
    "e2e:report": "playwright show-report"
  }
}
